# ==========================================
# Charmika By Lekshmi - Environment Settings
# ==========================================

# PayU Payment Gateway Configuration
# Get your Merchant Key and Salt from PayU Merchant Dashboard (https://onboarding.payu.in/)
NEXT_PUBLIC_PAYU_KEY=your_payu_merchant_key
PAYU_SALT=your_payu_merchant_salt
PAYU_ENV=live
# Set PAYU_ENV=test for sandbox/testing, or PAYU_ENV=live for real production payments

# Site URL
NEXT_PUBLIC_SITE_URL=https://charmikabylekshmi.com

# Node Backend API URL (To be configured when Node backend is integrated)
# BACKEND_API_URL=http://localhost:5000
